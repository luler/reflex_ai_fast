#默认使用的模型API服务
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxx

#设置即梦模型
JIMENG_MODEL=jimeng

#设置封面图使用的模型
COVER_OPENAI_BASE_URL=https://api.openai.com/v1
COVER_OPENAI_API_KEY=sk-xxx
COVER_MODEL=gpt-4o
COVER_COUNT=2
SCREEN_BASE_URL=http://10.8.0.2:14140

#谷歌Gemini图像模型
GEMINI_IMAGE_OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_IMAGE_OPENAI_API_KEY=sk-xxx
GEMINI_IMAGE_COVER_MODEL=google/gemini-2.5-flash-image-preview:free

#Grok图像模型
GROK_IMAGE_OPENAI_BASE_URL=https://api.openai.com/v1
GROK_IMAGE_OPENAI_API_KEY=sk-xxx
GROK_IMAGE_IMAGE_MODEL=grok-imagine-1.0
GROK_IMAGE_IMAGE_EDIT_MODEL=grok-imagine-1.0-edit
GROK_VIDEO_MODEL=grok-imagine-1.0-video

#Mondo风格海报生成器
MONDO_OPENAI_BASE_URL=https://api.openai.com/v1
MONDO_OPENAI_API_KEY=sk-xxx
MONDO_IMAGE_MODEL=gemini-3.1-flash-image-preview
MONDO_TEXT_MODEL=deepseek-v3-2-251201

#通用文生图生成器配置
TEXT2IMAGE_OPENAI_BASE_URL=https://xxx/v1
TEXT2IMAGE_OPENAI_API_KEY=sk-xxx
TEXT2IMAGE_MODEL=gpt-4o-image
TEXT2IMAGE_MODELS=gpt-4o-image,klein
TEXT2IMAGE_SIZES=1024x1024x(1:1),1024x1536x(2:3),1536x1024x(3:2),1024x576x(16:9),576x1024x(9:16),1024x768x(4:3),768x1024x(3:4)
# 按 TEXT2IMAGE_MODELS 顺序配置每个模型生成张数，例如 1,3 表示第一个模型生成1张、第二个模型生成3张
TEXT2IMAGE_N=1,3
TEXT2IMAGE_TITLE=通用文生图生成器

#通用文生视频生成器配置 (支持 OpenAI 兼容接口)
TEXT2VIDEO_OPENAI_BASE_URL=https://xxx/v1
TEXT2VIDEO_OPENAI_API_KEY=sk-xxx
TEXT2VIDEO_MODEL=muse-video
TEXT2VIDEO_MODELS=muse-video
TEXT2VIDEO_SIZES=1280x720 (16:9 高清横屏),720x1280 (9:16 高清竖屏),1920x1080 (16:9 全高清横屏),1080x1920 (9:16 全高清竖屏),1024x1024 (1:1 超清正方形),720x720 (1:1 高清正方形),1024x768 (4:3 高清横屏),768x1024 (3:4 高清竖屏),1792x1024 (16:9 超清横屏),1024x1792 (9:16 超清竖屏),1680x720 (21:9 宽屏电影),1080x720 (3:2 摄影横屏),720x1080 (2:3 摄影竖屏),960x540 (16:9 标清横屏),540x960 (9:16 标清竖屏)
TEXT2VIDEO_DURATION=5秒
TEXT2VIDEO_DURATIONS=5秒,10秒
TEXT2VIDEO_TITLE=通用文生视频生成器
TEXT2VIDEO_ALLOW_EDIT=0

#翻译代理
translate_proxy=

# fal.ai的API KEY
FAL_KEY=

# aichart的访问地址
AICHART_BASE_URL=
AICHART_API_KEY=

#管理授权码
AUTH_KEY=

# 额度超限提示文案（支持自定义重置引导地址，留空则使用默认提示）
QUOTA_EXCEEDED_MSG=当前应用的额度已用完，如需继续使用，请前往该地址重置额度：https://cas.luler.top/memberQuota

# 模型独立额度配置示例（可选，支持URL参数quota覆盖）：
# URL支持单数值如 ?quota=5（各模型每天限5次），或键值对如 ?quota=muse-video:10,zimage:5
# 也可在.env中固定各模型默认额度：
# MODEL_QUOTA_MUSE_VIDEO=10
# MODEL_QUOTA_ZIMAGE=5
